# HMRC Developer Hub Configuration
# Environment: Sandbox / Production

# The environment base URL
# Sandbox: https://test-api.service.hmrc.gov.uk
# Production: https://api.service.hmrc.gov.uk
HMRC_BASE_URL=https://test-api.service.hmrc.gov.uk

# OAuth Client Credentials
HMRC_CLIENT_ID=your_client_id_here
HMRC_CLIENT_SECRET=your_client_secret_here

# Must match one of the Redirect URIs configured in the Developer Hub
HMRC_REDIRECT_URI=http://localhost:8000/callback

# Used to encrypt local database or tokens securely
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AES_GCM_KEY=your_encryption_key_here

# For MTD ITSA APIs - Server Tokens if applicable
SERVER_TOKEN=your_server_token_here
